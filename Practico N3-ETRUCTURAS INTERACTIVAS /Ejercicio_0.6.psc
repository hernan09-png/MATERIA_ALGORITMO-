Algoritmo Ejercicio_6
	
	definir num como entero 
	escribir "ingrese 20 numeros "
	escribir "------------------"
	Para i <- 1 Hasta 20  Hacer
		
		
		escribir "NUMERO ",i
		
		leer num
		
		si num >0 Entonces
			escribir "Positivo"
		sino 
			si num<0 Entonces
				escribir "Negativo"
			SiNo
				
					escribir "Nulo"
					
				
				
			FinSi
		FinSi
		
	FinPara
	
FinAlgoritmo
